#copy to .env.local to change it, .env.local is gitignored
#anything prefixed VITE_ is bundled into the browser, so never put a secret here

#who answers the api calls while role 1's part 2 routes are being built
#  off     every call goes to the real api through the /api proxy (default)
#  part2   register, login and profile use the real part 1 api, the gig,
#          booking, transaction, income and admin routes use the in browser mock
#  all     everything is mocked with demo accounts, password Password123
#          lerato@example.co.za (client), thandi@example.co.za (freelancer),
#          admin@hustlehub.co.za (admin)
VITE_API_MOCKS=off
