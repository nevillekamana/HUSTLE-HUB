{
  "info": {
    "name": "HustleHub+ API",
    "description": "Covers all 5 HustleHub+ auth endpoints plus required negative-path scenarios (duplicate email, wrong password, missing fields, malformed JSON). Run against a local instance started with `npm run dev` in /api, over HTTPS with a self-signed cert (disable SSL certificate verification in Postman settings for local testing).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "testEmail", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health - service up",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Register",
      "item": [
        {
          "name": "POST /auth/register - success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'user' + Date.now() + '@example.com');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"client\"\n}"
            }
          },
          "response": [],
          "expected": "201 - success: true, data.user present, no password fields returned"
        },
        {
          "name": "POST /auth/register - duplicate email (run after success, expect 409)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"client\"\n}"
            }
          },
          "response": [],
          "expected": "409 - success: false, message about email already registered"
        },
        {
          "name": "POST /auth/register - missing fields",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"missingfields@example.com\"\n}"
            }
          },
          "response": [],
          "expected": "400 - success: false, errors array naming missing fields"
        },
        {
          "name": "POST /auth/register - invalid email format",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"Password123\",\n  \"role\": \"client\"\n}"
            }
          },
          "response": [],
          "expected": "400 - validation failed on email"
        },
        {
          "name": "POST /auth/register - weak password (too short / no digit)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"weakpass@example.com\",\n  \"password\": \"short\",\n  \"role\": \"client\"\n}"
            }
          },
          "response": [],
          "expected": "400 - validation failed on password"
        },
        {
          "name": "POST /auth/register - disallowed role (admin)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"wannabeadmin@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"admin\"\n}"
            }
          },
          "response": [],
          "expected": "400 - role must be client or freelancer; admin cannot be self-assigned (no route in this API creates an admin user, documented as a known gap)"
        },
        {
          "name": "POST /auth/register - malformed JSON body",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{ \"fullName\": \"Test User\", \"email\": "
            }
          },
          "response": [],
          "expected": "400 - safe message 'the request body is not valid json', no stack trace or file paths"
        }
      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "POST /auth/login - success (captures token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "response": [],
          "expected": "200 - success: true, data.user and data.token present. Run Register success first so {{testEmail}} exists."
        },
        {
          "name": "POST /auth/login - wrong password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"WrongPassword999\"\n}"
            }
          },
          "response": [],
          "expected": "401 - generic invalid credentials message"
        },
        {
          "name": "POST /auth/login - unknown email (same 401 message as wrong password)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doesnotexist@example.com\",\n  \"password\": \"WhateverPassword123\"\n}"
            }
          },
          "response": [],
          "expected": "401 - message must be byte-for-byte identical to the wrong-password case, proving the API does not leak which emails exist"
        },
        {
          "name": "POST /auth/login - missing fields",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
            }
          },
          "response": [],
          "expected": "400 - password required"
        },
        {
          "name": "POST /auth/login - malformed JSON body",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"a@b.com\", \"password\": "
            }
          },
          "response": [],
          "expected": "400 - safe message 'the request body is not valid json'"
        },
        {
          "name": "POST /auth/login - rate limited (run this request 6x quickly with wrong password)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"WrongPassword999\"\n}"
            }
          },
          "response": [],
          "expected": "429 on the 6th failed attempt within 60s - only failures count toward the limit"
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "GET /auth/profile - valid token",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": "{{baseUrl}}/auth/profile"
          },
          "response": [],
          "expected": "200 - success: true, data.user present. Run Login success first so {{token}} is set."
        },
        {
          "name": "GET /auth/profile - missing token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/profile"
          },
          "response": [],
          "expected": "401 - authentication required"
        },
        {
          "name": "GET /auth/profile - malformed token",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer not-a-real-token" } ],
            "url": "{{baseUrl}}/auth/profile"
          },
          "response": [],
          "expected": "401 - invalid token, no jwt library error detail leaked"
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "GET /auth/admin - non-admin token (expect 403)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": "{{baseUrl}}/auth/admin"
          },
          "response": [],
          "expected": "403 - authenticated but not authorized. NOTE: this collection cannot demonstrate the 200/admin-success case because the register endpoint only allows self-assigning 'client' or 'freelancer' (api/models/userModel.js SELF_ASSIGNABLE_ROLES) - no route creates an admin user. Documented as a known gap in the submission package."
        },
        {
          "name": "GET /auth/admin - missing token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/admin"
          },
          "response": [],
          "expected": "401 - authentication required"
        }
      ]
    }
  ]
}
