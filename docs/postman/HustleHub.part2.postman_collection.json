{
  "info": {
    "name": "HustleHub.part2",
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "description": "Full Role 4 Postman collection for Part 2 testing. Generated by Role 4. Run with Newman as documented in docs/testing.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5000/api" },
    { "key": "testPassword", "value": "Password1" },
    { "key": "adminEmail", "value": "", "type": "string" },
    { "key": "adminPassword", "value": "", "type": "string" },
    { "key": "runId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// collection-level pre-request: ensure runId and generated emails",
          "if(!pm.collectionVariables.get('runId')){",
          "  const rid = Date.now().toString().slice(-6) + Math.floor(Math.random()*999).toString();",
          "  pm.collectionVariables.set('runId', rid);",
          "  pm.collectionVariables.set('clientEmail', `client.${rid}@example.com`);",
          "  pm.collectionVariables.set('freelancerAEmail', `freelancera.${rid}@example.com`);",
          "  pm.collectionVariables.set('freelancerBEmail', `freelancerb.${rid}@example.com`);",
          "  pm.collectionVariables.set('otherClientEmail', `otherclient.${rid}@example.com`);",
          "  pm.collectionVariables.set('testPassword', pm.collectionVariables.get('testPassword') || 'Password1');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1-Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('envelope success', () => pm.expect(res).to.have.property('success', true));",
            "pm.test('data.status ok', () => pm.expect(res.data).to.have.property('status', 'ok'));",
            "pm.test('no secrets leaked', () => pm.expect(pm.response.text()).to.not.match(/passwordHash|MongoServerError|node_modules|stack/));"
          ] } }]
        }
      ]
    },
    {
      "name": "2-Accounts and login",
      "item": [
        {
          "name": "POST /auth/register - client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Client {{runId}}\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"client\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "pm.test('envelope success', () => pm.expect(res).to.have.property('success', true));",
            "pm.test('data.user exists', () => pm.expect(res.data).to.have.property('user'));",
            "pm.test('no password leak', () => pm.expect(pm.response.text()).to.not.match(/passwordHash|password/));",
            "if(res.data && res.data.user && res.data.user.id) pm.collectionVariables.set('clientId', res.data.user.id);"
          ] } }]
        },
        {
          "name": "POST /auth/register - freelancerA",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Freelancer A {{runId}}\",\n  \"email\": \"{{freelancerAEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"freelancer\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "if(res.data && res.data.user && res.data.user.id) pm.collectionVariables.set('freelancerAId', res.data.user.id);"
          ] } }]
        },
        {
          "name": "POST /auth/register - freelancerB",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Freelancer B {{runId}}\",\n  \"email\": \"{{freelancerBEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"freelancer\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "if(res.data && res.data.user && res.data.user.id) pm.collectionVariables.set('freelancerBId', res.data.user.id);"
          ] } }]
        },
        {
          "name": "POST /auth/register - other client",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Other Client {{runId}}\",\n  \"email\": \"{{otherClientEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"client\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "if(res.data && res.data.user && res.data.user.id) pm.collectionVariables.set('otherClientId', res.data.user.id);"
          ] } }]
        },
        {
          "name": "POST /auth/login - capture tokens",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('token returned', () => pm.expect(res.data).to.have.property('token'));",
            "if(res.data && res.data.token) pm.collectionVariables.set('clientToken', res.data.token);",
            "if(res.data && res.data.user && res.data.user.id) pm.collectionVariables.set('clientId', res.data.user.id);"
          ] } }]
        }
      ]
    },
    {
      "name": "3-JWT on protected routes",
      "item": [
        {
          "name": "GET /auth/profile - valid token",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }], "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth","profile"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('200 profile', () => pm.response.to.have.status(200));",
            "pm.test('returns user', () => pm.expect(res.data).to.have.property('user'));"
          ] } }]
        },
        {
          "name": "GET /auth/profile - missing token",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth","profile"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 missing', () => pm.response.to.have.status(401));",
            "const res = pm.response.json();",
            "pm.test('envelope false', () => pm.expect(res).to.have.property('success', false));"
          ] } }]
        }
      ]
    },
    {
      "name": "4-RBAC denials",
      "item": [
        {
          "name": "POST /gigs - client should be 403",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{clientToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"X\",\n  \"description\": \"desc desc desc\",\n  \"category\": \"design\",\n  \"priceCents\": 1000\n}" }, "url": { "raw": "{{baseUrl}}/gigs", "host": ["{{baseUrl}}"], "path": ["gigs"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('client forbidden to create gig', () => pm.response.to.have.status(403) || pm.response.to.have.status(401));",
            "const res = pm.response.json();",
            "pm.test('envelope false', () => pm.expect(res).to.have.property('success', false));"
          ] } }]
        }
      ]
    },
    {
      "name": "5-Validation & Malicious Input",
      "item": [
        {
          "name": "POST /gigs - empty body -> 400",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{freelancerAToken}}" }], "body": { "mode": "raw", "raw": "{}" }, "url": { "raw": "{{baseUrl}}/gigs", "host": ["{{baseUrl}}"], "path": ["gigs"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 for missing fields', () => pm.response.to.have.status(400));",
            "const res = pm.response.json();",
            "pm.test('envelope false', () => pm.expect(res).to.have.property('success', false));"
          ] } }]
        }
      ]
    },
    {
      "name": "6-Gigs (freelancer flows)",
      "item": [
        {
          "name": "POST /gigs - freelancer A creates gig",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{freelancerAToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Build API {{runId}}\",\n  \"description\": \"A complete gig description for tests\",\n  \"category\": \"development\",\n  \"priceCents\": 15000\n}" }, "url": { "raw": "{{baseUrl}}/gigs", "host": ["{{baseUrl}}"], "path": ["gigs"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "pm.test('gig returned', () => pm.expect(res.data).to.have.property('gig'));",
            "if(res.data && res.data.gig && res.data.gig.id) pm.collectionVariables.set('gigId', res.data.gig.id);"
          ] } }]
        },
        {
          "name": "GET /gigs - browse includes gig",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/gigs", "host": ["{{baseUrl}}"], "path": ["gigs"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('data.gigs array', () => pm.expect(res.data).to.have.property('gigs'));",
            "pm.test('pagination fields', () => { pm.expect(res.data).to.have.property('page'); pm.expect(res.data).to.have.property('limit'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "7-Bookings, Transactions & Income",
      "item": [
        {
          "name": "POST /bookings - client books gig",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{clientToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"gigId\": \"{{gigId}}\"\n}" }, "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "pm.test('booking returned', () => pm.expect(res.data).to.have.property('booking'));",
            "pm.test('transaction returned', () => pm.expect(res.data).to.have.property('transaction'));",
            "if(res.data && res.data.booking && res.data.booking.id) pm.collectionVariables.set('bookingId', res.data.booking.id);",
            "if(res.data && res.data.transaction && res.data.transaction.id) pm.collectionVariables.set('transactionId', res.data.transaction.id);"
          ] } }]
        },
        {
          "name": "GET /bookings/mine - client sees booking",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }], "url": { "raw": "{{baseUrl}}/bookings/mine", "host": ["{{baseUrl}}"], "path": ["bookings","mine"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('bookings array', () => pm.expect(res.data).to.have.property('bookings'));"
          ] } }]
        },
        {
          "name": "GET /income/me - freelancerA",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{freelancerAToken}}" }], "url": { "raw": "{{baseUrl}}/income/me", "host": ["{{baseUrl}}"], "path": ["income","me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const res = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('income object', () => pm.expect(res.data).to.have.property('income'));"
          ] } }]
        }
      ]
    },
    {
      "name": "8-Rate limiting (manual run last)",
      "item": [
        {
          "name": "POST /auth/login - wrong password (loop to 429)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"wrongpass\"\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "// This request is intended to be run in a loop using setNextRequest and a counter variable in Postman to reach a 429 response",
            "// Assert 401 or 429 depending on iteration",
            "if(pm.response.code === 401) pm.test('invalid credentials', () => pm.expect(pm.response.code).to.equal(401));",
            "if(pm.response.code === 429){",
            "  const r = pm.response.json();",
            "  pm.test('429 rate limit', () => pm.expect(pm.response.code).to.equal(429));",
            "  pm.test('errors[0].field rateLimit', () => pm.expect(r.errors && r.errors[0] && r.errors[0].field).to.equal('rateLimit'));",
            "}"
          ] } }]
        }
      ]
    }
  ]
}
