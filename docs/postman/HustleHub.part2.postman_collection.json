{
  "info": {
    "name": "HustleHub.part2",
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "description": "Postman collection for Role 4: testing and Newman runs. Contains health and auth smoke tests. Full collection maintained by Role 4 under docs/postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5000/api" },
    { "key": "testPassword", "value": "Password1" },
    { "key": "adminEmail", "value": "", "type": "string" },
    { "key": "adminPassword", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope success', () => pm.expect(res).to.have.property('success', true));",
                  "pm.test('data.status ok', () => pm.expect(res.data).to.have.property('status', 'ok'));",
                  "pm.test('no secrets leaked', () => pm.expect(pm.response.text()).to.not.match(/passwordHash|MongoServerError|node_modules/));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register - client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": "Client {{runId}}",\n  \"email\": "client.{{runId}}@example.com",\n  \"password\": "{{testPassword}}",\n  \"role\": "client"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('envelope success', () => pm.expect(res).to.have.property('success', true));",
                  "pm.test('user returned', () => pm.expect(res.data).to.have.property('user'));",
                  "pm.test('no password leak', () => pm.expect(pm.response.text()).to.not.match(/passwordHash|password/));",
                  "if (res.data && res.data.user && res.data.user.id) pm.collectionVariables.set('clientId', res.data.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
