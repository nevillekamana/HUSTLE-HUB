#copy this file to .env and fill in the values
#.env is gitignored and must never be committed, this example is the only
#version of it that belongs in the repository

#-----------------------------------------------------------------------------
#runtime
#-----------------------------------------------------------------------------

#development or production
NODE_ENV=development

#the port the api listens on, defaults to 5000 when unset
PORT=5000

#-----------------------------------------------------------------------------
#tokens
#-----------------------------------------------------------------------------

#the secret every token is signed with, generate one with
#  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#leaving this blank still boots, but the api generates a throwaway secret for
#that process, so every token stops verifying the moment it restarts
JWT_SECRET=

#how long an issued token stays valid, any value jsonwebtoken accepts
JWT_EXPIRES_IN=1h

#-----------------------------------------------------------------------------
#password hashing
#-----------------------------------------------------------------------------

#bcrypt work factor, higher is slower to compute and slower to attack
#anything below 10 is raised to 10 by the config loader
BCRYPT_ROUNDS=12

#-----------------------------------------------------------------------------
#database
#-----------------------------------------------------------------------------

#where the api's data lives, leaving this blank in development connects to a
#mongo instance on this machine, outside development it must be set
#for a local instance:  mongodb://127.0.0.1:27017/hustlehub
#for atlas:             mongodb+srv://<user>:<password>@<cluster>/hustlehub
MONGO_URI=mongodb://127.0.0.1:27017/hustlehub

#-----------------------------------------------------------------------------
#network
#-----------------------------------------------------------------------------

#only set this to true when the api is running behind a real reverse proxy
#that terminates tls (part 3's docker/nginx setup). with nothing in front of
#it, trusting a client supplied address lets every ip keyed rate limit be
#walked straight through
TRUST_PROXY=false

#-----------------------------------------------------------------------------
#https
#-----------------------------------------------------------------------------

#the certificate bundle the server presents, never committed
#with no file at this path the api starts over http and warns that it has
#SSL_PFX_PATH=./certs/localhost.pfx

#the password protecting that bundle
#SSL_PFX_PASSWORD=

#every new variable must also be read in config/env.js, which is the only
#file in the api that touches process.env

# Rate limits (optional). The defaults are shown. Windows are in milliseconds.
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_REGISTER_MAX=30
# RATE_LIMIT_REGISTER_WINDOW_MS=900000
# RATE_LIMIT_BOOKING_MAX=10
# RATE_LIMIT_BOOKING_WINDOW_MS=60000
